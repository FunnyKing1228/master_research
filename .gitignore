# ============================================================
# conformal-microgrid-rl project-specific rules
# ============================================================

# --- Local configuration files with machine-specific paths ---
config_gui.json
# Use configs/config_gui.template.json as the public template.

# --- Model checkpoints and serialized artifacts ---
*.pth
*.pt
*.ckpt
*.pkl
# If a final RL checkpoint must be tracked, add it explicitly with git add -f.
# Exception: lightweight SoH predictor artifacts required for bundled inference.
!core/soh_predictor/model/*.pth
!core/soh_predictor/model/*.npz

# --- Experiment outputs ---
experiments/
ablation_results/
stressm_analysis_results/
batch_logs/

# --- Large or generated data files ---
*.h5
*.hdf5
*.csv

# --- Runtime hardware/vendor data ---
Data_ID*/
vendor_logs/
archive/
archive.zip
data/raw/replay/
data/raw/*
!data/raw/.gitkeep
data/raw/deployment_*report.png
data/soh_segments*/
data/processed/
data/processed/analysis/

# --- Example outputs ---
examples/**/results/
examples/**/*.zip

# --- PyInstaller and release artifacts ---
*.exe
*.spec
!packaging/*.spec
dist/
build/
release*/
Microgrid_AI/

# --- Archive bundles (avoid committing large / third-party zips) ---
# Blocks docs/ReferencePaper_New.zip (third-party papers), thesis_sim.zip,
# data/data.zip and any other *.zip from being accidentally pushed.
*.zip
!packaging/*.zip

# --- Chapter 4 thesis simulation is version-controlled (incl. outputs) ---
# Re-include thesis_sim so global *.csv / output rules do not exclude it.
!thesis_sim/
!thesis_sim/**
thesis_sim/**/*.zip

# --- Windows system files ---
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
# --- Third-party reference papers (copyright: do not publish) ---
docs/refPaper/
